{{> head}}
<main id="main" class="kern-container main">
    {{#tag}}<h1 class="kern-heading-x-large">{{name}}</h1>{{/tag}}
    {{#each posts}}
    <article class="post-teaser">
        <h2 class="kern-heading-medium"><a class="kern-link" href="{{url}}">{{title}}</a></h2>
        <p class="kern-body kern-body--muted">{{date createdAt 'DD.MM.YYYY'}}</p>
    </article>
    {{/each}}
    {{> pagination}}
</main>
{{> footer}}
